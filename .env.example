# Copy to .env. To just try the agent: set OPENAI_API_KEY below, then `docker compose up -d --build`
# and open http://127.0.0.1:8000. Demo mode needs nothing else; the rest is for BACKEND=live.

# demo: a simulated homelab with a disk filling up on cue (no infrastructure needed).
# live: your real Proxmox + Grafana (fill in the Proxmox and Grafana sections below).
BACKEND=demo

# --- LLM ---------------------------------------------------------------------------------
# openai for real runs. For troubleshooting on a free local model: ollama (direct to the Ollama
# server) or gateway (via the MLflow AI Gateway endpoint; create it with `python -m agent.gateway_setup`).
LLM_PROVIDER=openai
# "none" for reasoning models (e.g. gpt-5.x) behind the agent's tools; unset for gpt-4.1.
# LLM_REASONING_EFFORT=none
# One stable endpoint; choose its models and fallbacks in MLflow (AI Gateway > Endpoints).
MLFLOW_GATEWAY_ENDPOINT=datacenter-agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Your Ollama server, and a tool-calling model pulled on it.
OLLAMA_BASE_URL=http://ollama.lan:11434
OLLAMA_MODEL=qwen3.5:latest
# Context window for direct Ollama (LLM_PROVIDER=ollama). Via the gateway, set OLLAMA_CONTEXT_LENGTH on the server.
# OLLAMA_NUM_CTX=16384

# --- Proxmox (proxmoxer, API token auth) --------------------------------------------------
# Hostname or IP only (API port 8006 is assumed).
PROXMOX_HOST=pve.lan
# Token owner and token name, from Datacenter > Permissions > API Tokens.
# Scope it narrowly: PVEAuditor on /, plus VM.PowerMgmt only on the containers it may restart.
PROXMOX_USER=agent@pve
PROXMOX_TOKEN_NAME=disk-agent
PROXMOX_TOKEN_VALUE=00000000-0000-0000-0000-000000000000
PROXMOX_VERIFY_SSL=false
PROXMOX_NODE=pve
# Which containers the agent may restart, always after approval (enforced in code):
# "all", a list like "104,105", or empty for none (diagnose only). Protected IDs never restart.
PROXMOX_MANAGED_VMIDS=all
PROXMOX_PROTECTED_VMIDS=

# --- Grafana, via mcp-grafana (runs in docker compose) ----------------------------------------
# For mcp-grafana: your Grafana, and a Viewer service-account token from it
# (Administration > Users and access > Service accounts > Add > Add token).
GRAFANA_URL=http://grafana.lan:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...
# For host-side runs (CLI, evals). The compose agent uses http://mcp-grafana:8000/mcp instead.
GRAFANA_MCP_URL=http://127.0.0.1:8001/mcp
# NOT the Grafana token: a random password the agent must present to mcp-grafana,
# e.g. from: openssl rand -hex 32
GRAFANA_MCP_TOKEN=
# UID of the Prometheus datasource in Grafana that scrapes prometheus-pve-exporter.
GRAFANA_DATASOURCE_UID=prometheus
# Optional overrides if your metrics differ from prometheus-pve-exporter's defaults:
# DISK_USAGE_PROMQL=100 * pve_disk_usage_bytes{id=~"lxc/.*"} / pve_disk_size_bytes{id=~"lxc/.*"}
# GUEST_INFO_PROMQL=pve_guest_info

# --- MLflow ----------------------------------------------------------------------------------
# `docker compose up -d` serves MLflow here. Point elsewhere to use a shared server.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
# Encrypts AI Gateway secrets in the compose MLflow, e.g. from: openssl rand -hex 32
MLFLOW_CRYPTO_KEK_PASSPHRASE=
# Judge model for LLM-judge scorers in evals.
# EVAL_JUDGE_MODEL=openai:/gpt-4.1
